rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Verify user authentication and UID ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. User Root Document
    //
    // Phase 11 RBAC defense-in-depth:
    // The authoritative admin role is resolved SERVER-SIDE from the
    // ADMIN_EMAIL_ALLOWLIST environment variable — never from a
    // Firestore document. To make privilege escalation impossible in
    // Firestore too, a user document may NOT carry a 'role' field with
    // value 'admin'. The only permitted client-writable role value is
    // 'user' (which is also the default). This is strictly restrictive
    // (never loosening) and preserves all existing ownership rules.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (
          !('role' in request.resource.data)
          || request.resource.data.role == 'user'
        );
      allow delete: if false; // Deletions handled exclusively via backend cascade endpoint
    }

    // Helper: Validate optional location schema (Phase 9)
    // Location is optional; when present it must be a valid coordinate object.
    function isValidLocation(location) {
      return location is map
          && location.latitude is number
          && location.longitude is number
          && location.latitude >= -90 && location.latitude <= 90
          && location.longitude >= -180 && location.longitude <= 180
          && (!('label' in location) || location.label is string);
    }

    // Helper: Validate entry schema & constraints
    function isValidEntry(data) {
      return data.title is string
          && data.content is string
          && data.moodRating is number
          && data.moodRating >= 1 && data.moodRating <= 5
          && data.tags is list
          && data.wordCount is number
          && data.wordCount >= 0
          && data.crisisFlagged == false
          && (!('location' in data) || isValidLocation(data.location));
    }

    // 2. Standalone Journal Entries (Client-owned raw data)
    match /users/{userId}/entries/{entryId} {
      allow read, delete: if isOwner(userId);

      allow create: if isOwner(userId)
                    && isValidEntry(request.resource.data)
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp;

      allow update: if isOwner(userId)
                    && isValidEntry(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt is timestamp;
    }

    // 3. Conversations (Hybrid ownership)
    match /users/{userId}/conversations/{conversationId} {
      allow read: if isOwner(userId);

      // Client creation: initial status must be 'active', summary fields must be null
      allow create: if isOwner(userId)
                    && request.resource.data.status == "active"
                    && (!('summary' in request.resource.data) || request.resource.data.summary == null)
                    && (!('summaryUpdatedAt' in request.resource.data) || request.resource.data.summaryUpdatedAt == null);

      // Client update: authenticated owner may update legitimate client-owned
      // metadata (e.g. title, updatedAt), but is strictly forbidden from
      // creating, modifying, or removing backend-owned lifecycle fields:
      // status, summary, summaryUpdatedAt.
      //
      // NARROW FALLBACK (AI Studio preview sandbox):
      //   When the backend lacks Firestore IAM, it returns the
      //   Gemini-generated summary and the authenticated client
      //   completes the conversation via the Client SDK. This
      //   fallback is tightly constrained:
      //     - existing status must be exactly "active"
      //     - requested status must be exactly "completed"
      //     - summary must be a string of 10–10000 chars
      //     - summaryUpdatedAt must be a timestamp
      //     - only status, summary, summaryUpdatedAt, updatedAt may change
      //   It does NOT permit completed→active, completed→completed
      //   summary edits, or arbitrary lifecycle field modification.
      allow update: if isOwner(userId)
                    && (
                      // Existing normal client metadata updates
                      !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['status', 'summary', 'summaryUpdatedAt'])

                      ||

                      // Narrow AI Studio persistence fallback
                      (
                        resource.data.status == "active"
                        && request.resource.data.status == "completed"
                        && request.resource.data.summary is string
                        && request.resource.data.summary.size() >= 10
                        && request.resource.data.summary.size() <= 10000
                        && request.resource.data.summaryUpdatedAt is timestamp
                        && request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly([
                            'status',
                            'summary',
                            'summaryUpdatedAt',
                            'updatedAt'
                          ])
                      )
                    );

      allow delete: if isOwner(userId);

      // 4. Messages Subcollection
      match /messages/{messageId} {
        allow read: if isOwner(userId);

        // Message provenance: Client may create user-authored messages
        // (role == "user") AND assistant messages (role == "assistant").
        //
        // Assistant message creation by the owner is permitted as a
        // NARROW capability fallback for the AI Studio preview sandbox,
        // where the backend Admin SDK persistence lacks Firestore IAM.
        // In that case the backend returns the Gemini-generated response
        // and the authenticated client persists it here under existing
        // ownership rules (isOwner). Production backend persistence via
        // Admin SDK always remains preferred.
        allow create: if isOwner(userId)
                      && (request.resource.data.role == "user"
                          || request.resource.data.role == "assistant");

        // Message updates are forbidden (messages remain immutable).
        allow update: if false;

        // Cascade deletion allowed for conversation owner
        allow delete: if isOwner(userId);
      }
    }

    // 5. PatternShift Insights (Read-only for client; written strictly by Firebase Admin SDK)
    match /users/{userId}/insights/{insightId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // 6. Distributed Rate Limiter & Security State (Backend-only)
    match /users/{userId}/limits/{documentId} {
      allow read, write: if false;
    }

    // Default Deny for all other documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
