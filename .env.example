# ============================================================
# GOOGLE CLOUD SECRET MANAGER
# ============================================================
#
# USE_SECRET_MANAGER: Enable Google Cloud Secret Manager for production.
# When enabled, secrets are retrieved from Secret Manager instead of environment variables.
# 
# SECURITY: This is a SERVER-SIDE configuration. Never expose to frontend.
#
# Local Development: Set to false (default) and use environment variables below.
# Production: Set to true and configure secrets in Google Cloud Secret Manager.
#
USE_SECRET_MANAGER=false

# GOOGLE_CLOUD_PROJECT: Google Cloud project ID for Secret Manager.
# Required when USE_SECRET_MANAGER=true.
# In Cloud Run, this is automatically provided by the runtime.
#
GOOGLE_CLOUD_PROJECT="MY_PROJECT_ID"

# ============================================================
# SECRETS - LOCAL DEVELOPMENT ONLY
# ============================================================
#
# GEMINI_API_KEY: Required for Gemini AI API calls.
# 
# SECURITY WARNINGS:
# - This is a SERVER-SIDE environment variable (never prefix with VITE_)
# - Never commit real API keys to version control
# - In production, use Google Cloud Secret Manager instead
#
# Local Development: Set this value in .env.local (not committed to git)
# Production: Create secret in Google Cloud Secret Manager named 'GEMINI_API_KEY'
#
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================

# GEMINI_MODEL: Active Gemini model for server-side reflection and summarization.
# Reflectra architecture standard default: gemini-3.6-flash
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_CHECK_REVOKED: Configure whether token revocation status is checked via Identity Toolkit.
# Production MUST use true (default if unset). Set to false ONLY in AI Studio Preview sandbox due to ambient ADC project boundaries.
FIREBASE_CHECK_REVOKED=false

# ============================================================
# RBAC — ADMIN EMAIL ALLOWLIST (Phase 11)
# ============================================================
#
# ADMIN_EMAIL_ALLOWLIST: Comma-separated list of email addresses
# granted the 'admin' role.
#
# SECURITY:
# - This is a SERVER-SIDE-only configuration (never VITE_ prefixed).
# - It is the authoritative source of the admin role.
# - A user's role is resolved EXCLUSIVELY from this list.
# - Absence of this variable means NO users are admins (fail-safe).
# - Users CANNOT change their own role from the client.
#
# Format: ADMIN_EMAIL_ALLOWLIST="admin1@example.com,admin2@example.com"
#
# Local development / demo: set to your own Google account email
# to exercise the admin console.
#
ADMIN_EMAIL_ALLOWLIST=""

# ============================================================
# DEMO MODE — DEVELOPMENT ONLY
# ============================================================
#
# VITE_DEMO_MODE: Enable local demo workspace for UI preview.
# 
# SECURITY: Demo mode is DISABLED by default and must be explicitly enabled.
# It is gated by this environment variable — NOT by NODE_ENV.
#
# Demo mode does NOT:
# - Create Firebase tokens
# - Call backend APIs
# - Write to production Firestore
# - Invoke Gemini
# - Bypass authentication in production
#
# USAGE:
# 1. Create .env.local with: VITE_DEMO_MODE=true
# 2. Run: npm run dev
# 3. Click "Explore Demo →" on the landing page
#
# Production: VITE_DEMO_MODE must be absent or false.
#
VITE_DEMO_MODE=true

