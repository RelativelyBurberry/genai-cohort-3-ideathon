# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Active Gemini model for server-side reflection and summarization.
# Reflectra architecture standard default: gemini-3.6-flash
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_CHECK_REVOKED: Configure whether token revocation status is checked via Identity Toolkit.
# Production MUST use true (default if unset). Set to false ONLY in AI Studio Preview sandbox due to ambient ADC project boundaries.
FIREBASE_CHECK_REVOKED=false

